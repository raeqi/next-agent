# 复制为 .env。三项都留空时是演示模式：剧本回复，不调用真实模型。
# 要体验真实能力再填写。key 只放在 MODEL_API_KEY，不要提交到仓库。
# 已有 key 仍想看演示：DEMO_MODE=1
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# 机会判断与内容处理可分开指定；留空则都用 MODEL_NAME。
# MODEL_TRIAGE_NAME=
# MODEL_DRAFT_NAME=

# 示例（保留注释，按需抄到上面三行；模型 id 以服务商当前文档为准）：
# OpenAI       https://api.openai.com/v1                          gpt-4.1
# DeepSeek     https://api.deepseek.com                           deepseek-v4-pro
# Kimi 中国站  https://api.moonshot.cn/v1                         kimi-k3.1-pro
# Kimi 国际站  https://api.moonshot.ai/v1                         kimi-k3.1-pro
# 通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
# 智谱         https://open.bigmodel.cn/api/paas/v4               glm-4.7

SHIYI_PORT=18746
# SHIYI_HOME=/absolute/path/to/shiyi-data
