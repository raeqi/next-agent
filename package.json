{
  "name": "shiyi-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "start:headless": "node --env-file-if-exists=.env scripts/start.mjs --no-pet",
    "test": "node scripts/model-config-test.mjs && node scripts/actions-test.mjs",
    "check:model": "node --env-file-if-exists=.env scripts/check-model.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh": "0.2.2-rc.1"
  },
  "overrides": {
    "undici": "8.12.2",
    "fflate": "0.8.3",
    "@modelcontextprotocol/client": "2.3.0",
    "zod@^4.0.0": "4.6.7",
    "zod@^4.1.0": "4.6.7"
  }
}
